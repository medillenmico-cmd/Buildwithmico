# Canonical production origin. Set this to the final custom domain in Vercel.
SITE_URL=https://buildwithmico.vercel.app

# Contact storage and email delivery (server-only secrets).
SUPABASE_URL=
SUPABASE_SECRET_KEY=
RESEND_API_KEY=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=

# Cloudflare Turnstile. The site key is public; the secret is server-only.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
